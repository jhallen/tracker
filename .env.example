# Copy to .env and edit.  `scripts/setup.sh` does this for you.

# --- core -----------------------------------------------------------------
# SQLite database file (created by scripts/init_db.sh).
DATABASE_URL=greenhouse.db
BIND_ADDR=0.0.0.0:8080
# The URL people type into their browser. Must be https:// in production:
# phones only allow camera access (barcode scanning) on HTTPS or localhost,
# and OAuth providers require an exact redirect URI match.
BASE_URL=http://localhost:8080
UPLOAD_DIR=uploads
# Per-photo and per-request limits (megabytes).
MAX_UPLOAD_MB=15
MAX_REQUEST_MB=60
SESSION_HOURS=336
ALLOW_REGISTRATION=true
# Apply pending migrations at server start.
AUTO_MIGRATE=true
RUST_LOG=greenhouse_tracker=info,tower_http=info

# --- OAuth sign-in providers -------------------------------------------------
# A provider's button appears once BOTH its client id and secret are set.
# Register this redirect URI with the provider:
#     ${BASE_URL}/auth/<provider>/callback
# e.g. https://tracker.example.com/auth/google/callback

# Google  — https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Microsoft (personal, work & school accounts) — https://entra.microsoft.com
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# "common", "organizations", "consumers" or your tenant id
MICROSOFT_TENANT=common

# GitHub — https://github.com/settings/developers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# GitLab (gitlab.com or self-hosted) — User settings > Applications
GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=
GITLAB_BASE_URL=https://gitlab.com

# Facebook — https://developers.facebook.com/apps
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# Discord — https://discord.com/developers/applications
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Generic OpenID Connect (Okta, Auth0, Keycloak, Authentik, Zitadel, ...)
OIDC_DISPLAY_NAME="Company SSO"
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_AUTH_URL=
OIDC_TOKEN_URL=
OIDC_USERINFO_URL=
